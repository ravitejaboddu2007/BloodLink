# ==============================================================================
# BloodLink Environment Configuration Template
# Copy this file to .env and replace placeholders with production-grade values.
# NEVER commit .env files containing real secrets or credentials to version control.
# ==============================================================================

# Server Port
PORT=8080

# Production Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bloodlink?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_database_username
SPRING_DATASOURCE_PASSWORD=your_database_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_SQL_INIT_MODE=always

# Production JWT Secret Configuration
# MUST be a secure, random string with at least 256 bits (32+ characters or Base64 encoded)
JWT_SECRET=your_production_jwt_secret_key_at_least_256_bits_here
JWT_EXPIRATION_MS=604800000

# Centralized CORS Allowed Origins (comma-separated list of trusted frontend URLs or origin patterns)
BLOODLINK_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8080,http://127.0.0.1:5500,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
